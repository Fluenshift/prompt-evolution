#!/bin/sh
# Format and lint the staged files only. `bun run check` covers the whole tree.
set -e

git diff --cached --name-only -z --diff-filter=ACMR |
  xargs -0 -r bunx oxfmt --check --no-error-on-unmatched-pattern

git diff --cached --name-only -z --diff-filter=ACMR |
  xargs -0 -r bunx oxlint --no-error-on-unmatched-pattern

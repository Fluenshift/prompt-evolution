{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "calibrate:live": "bun src/evaluation/live-calibration.ts",
    "check-types": "tsc -b",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --format pretty",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@english-prompt-evaluation/db": "workspace:*",
    "@english-prompt-evaluation/env": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "effect": "catalog:",
    "elysia": "^1.4.29",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@english-prompt-evaluation/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}

{
  "name": "english-prompt-evaluation",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/vitest": "4.0.0-rc.112",
      "@types/bun": "^1.4.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "dotenv": "^17.4.2",
      "effect": "4.0.0-rc.112",
      "lucide-react": "^1.39.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "typescript": "7.0.2",
      "vitest": "^4.1.11"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "calibrate:live": "bun run --cwd apps/server calibrate:live",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "check:effect": "turbo run check:effect",
    "db:generate": "turbo run db:generate -F @english-prompt-evaluation/db --",
    "db:migrate": "turbo run db:migrate -F @english-prompt-evaluation/db --",
    "db:push": "turbo run db:push -F @english-prompt-evaluation/db --",
    "db:seed": "bun --cwd apps/server ../../scripts/seed-local.ts",
    "db:studio": "turbo run db:studio -F @english-prompt-evaluation/db --",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "docker:build": "PROMPT_EVOLUTION_UID=$(id -u) PROMPT_EVOLUTION_GID=$(id -g) docker compose build",
    "docker:down": "PROMPT_EVOLUTION_UID=$(id -u) PROMPT_EVOLUTION_GID=$(id -g) docker compose down",
    "docker:logs": "PROMPT_EVOLUTION_UID=$(id -u) PROMPT_EVOLUTION_GID=$(id -g) docker compose logs -f",
    "docker:smoke": "bun scripts/docker-smoke.ts",
    "docker:up": "PROMPT_EVOLUTION_UID=$(id -u) PROMPT_EVOLUTION_GID=$(id -g) docker compose up -d --build",
    "fix": "ultracite fix",
    "lint:effect": "oxlint --config oxlint.effect.config.ts apps/server packages/db packages/env",
    "prepare": "husky && effect-tsgo patch --typescript --oxlint",
    "setup": "bun install --frozen-lockfile && mkdir -p .data",
    "test": "turbo run test",
    "test:e2e": "bun run build && playwright test",
    "test:web": "turbo run test -F web",
    "verify": "bun run test && bun run check-types && bun run check:effect && bun run lint:effect && bun run check && bun run build"
  },
  "devDependencies": {
    "@effect/tsgo": "0.40.0",
    "@english-prompt-evaluation/config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/bun": "catalog:",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.4.0"
}
